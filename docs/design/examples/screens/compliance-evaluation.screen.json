{
  "g": 1,
  "kind": "screen",
  "key": "COMPLIANCE_EVALUATION",
  "name": "Evaluation",
  "description": "How compliance is kept up to date: what has changed and is waiting to be checked, the checks already made, any rule that could not be worked out, and a button to check everything now. Compliance is normally checked on its own, within seconds of a change and every hour.",
  "menu": {
    "group": "Compliance",
    "label": "Evaluation",
    "order": 42
  },
  "permission": "Obligation.Read",
  "screenKind": "list",
  "params": {
    "view": "compliance.vEvaluationQueue",
    "orderBy": "RequestedAt",
    "rowKey": "RequestId",
    "columns": [
      { "key": "RequestedAt", "label": "Requested" },
      { "key": "SubjectKind", "label": "What changed" },
      { "key": "SubjectName", "label": "Subject" },
      { "key": "Reason", "label": "Why" },
      { "key": "RequestedByName", "label": "Raised by" },
      { "key": "IsPending", "label": "Waiting" },
      { "key": "DevicesFound", "label": "Devices" }
    ],
    "textFilterColumns": ["SubjectName", "Reason"]
  }
}
