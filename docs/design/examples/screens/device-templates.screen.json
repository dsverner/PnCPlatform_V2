{
  "g": 1,
  "kind": "screen",
  "key": "DEVICE_TEMPLATES",
  "name": "Device templates",
  "description": "The relay models with a template, one row per model. Open a row for that model's settings list, capabilities and manual.",
  "menu": { "group": "Templates", "label": "Device templates", "order": 30 },
  "permission": "Asset.Read",
  "screenKind": "list",
  "params": {
    "view": "config.vAssetTemplate",
    "orderBy": "DefinitionKey",
    "rowKey": "ModelId",
    "columns": [
      { "key": "DefinitionKey", "label": "Template" },
      { "key": "ModelCode", "label": "Model" },
      { "key": "Manufacturer", "label": "Manufacturer" },
      { "key": "Technology", "label": "Technology" },
      { "key": "VersionNumber", "label": "Version" }
    ],
    "textFilterColumns": ["DefinitionKey", "ModelCode", "ModelName", "Manufacturer"],
    "rowOpen": { "label": "Open the template", "action": "openScreen", "screen": "DEVICE_TEMPLATE", "param": "ModelId" }
  }
}
